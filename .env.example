# Settings for `docker compose` (copy this file to `.env` and edit it).
# On your own computer you can skip this file entirely. On a server, set at least APP_URL and POSTGRES_PASSWORD.
# Every setting is explained in docs/configuration.md.

# The address people use to open Kanbanto. Used for links in emails (password resets, invites).
APP_URL=https://kanbanto.example.com

# The database password. Set it BEFORE the first start (it's fixed when the database is created).
POSTGRES_PASSWORD=change-me-to-something-long

# The port Kanbanto listens on, on this machine (default 3000).
# PORT=3000

# 127.0.0.1: reachable from this machine only (when your own proxy on this machine handles HTTPS).
# BIND_ADDRESS=127.0.0.1

# How many proxies are in front of Kanbanto (1 for nginx or Caddy on this machine). The HTTPS add-on sets it.
# TRUST_PROXY=1

# Optional. Kanbanto makes its own encryption key on first start (for the email and storage keys you save) and keeps
# it in a Docker volume. Set one here only to bring your own, e.g. when moving to a new server:
#   docker compose exec app node dist/cli.js key      shows the one in use
# ENCRYPTION_KEY=

# Optional: send email through your own mail server instead of setting it up in the Platform console.
# See docs/configuration.md#smtp_url. Special characters in the password must be URL-encoded (@ → %40).
# SMTP_URL=smtp://user:password@smtp.example.com:587
# SMTP_FROM=Kanbanto <kanbanto@example.com>

# Optional: where "Guides" in the account menu goes. By default, Kanbanto's guides at kanbanto.com. Your own address
# (your team's handbook, or a page on this site like /help) replaces it; off takes the item out of the menu.
# GUIDES_URL=https://wiki.example.com/kanbanto

# For the HTTPS add-on (deploy/docker-compose.https.yml): your domain, pointing at this server.
# DOMAIN=kanbanto.example.com

# The port the database is reachable on, from this machine only (default 5433). Change it if 5433 is taken.
# DB_PORT=5433

# json: one JSON object per log line, for log collectors (default: readable lines).
# LOG_FORMAT=json
