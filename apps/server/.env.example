# Copy to .env for local development.
DATABASE_URL=postgres://kankan:kankan@localhost:5433/kankan
PORT=3000
# The encryption key for saved email and storage keys is made on first start, in ./data/config (ignored by git).
# To share one with another install that uses the same database, set it here:
# ENCRYPTION_KEY=
# Development: emails go to Mailpit (started by `pnpm db:up`); read them at http://localhost:8025.
# Comment these out to try the Platform console's email settings instead.
SMTP_URL=smtp://localhost:1025?security=none
SMTP_FROM=Kanbanto <noreply@kanbanto.localhost>
# Or print emails in this terminal instead of sending them (then any Resend key is accepted):
# MAIL_TRANSPORT=log
# The site's address, used for links in emails (required in production). In development, links use the address
# each request came to.
# APP_URL=http://localhost:5173
# In production, serve the built web app from the same server:
# WEB_DIST=../web/dist
