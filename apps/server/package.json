{
  "name": "@kanbanto/server",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@kanbanto/model": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@react-email/render": "^2.2.0",
    "@scalar/fastify-api-reference": "^1.77.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nodemailer": "^10.3.1",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.4",
    "web-push": "3.6.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "smtp-server": "^3.21.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
